HTTP_PORT=9080
HTTP_BIND_ADDRESS=0.0.0.0
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=tenko
MQTT_PASSWORD=
MQTT_CLIENT_ID=tenko-local
MQTT_TLS=false
# Set to a container path when mounting a private CA.
MQTT_CA_FILE=
MQTT_PREFIX=tenko
DISCOVERY_PREFIX=homeassistant
FRESHNESS_TIMEOUT=180
CONFIRMATION_TIMEOUT=600
# Unknown from capture: disabled until both are explicitly configured.
STATUS_PATH=
STATUS_METHOD=
NO_CHANGE_BODY=nochange
# Optional comma-separated allowlist; useful on a shared LAN.
ALLOWED_SERIALS=211229_005
LOG_LEVEL=INFO
# Native Python only; Compose uses the persistent named volume instead.
STATE_PATH=data/state.json
